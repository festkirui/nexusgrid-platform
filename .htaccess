# ====================================================================
# NexusGrid — Apache Production Configuration (.htaccess)
# ====================================================================

# 1. Disable Directory Browsing
Options -Indexes

# 2. Block Access to Sensitive Files and Source Dumps
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|csv|env|sw[op])|~)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Specifically protect database dumps and config templates
<Files "schema.sql">
    Require all denied
</Files>
<Files "database.sql">
    Require all denied
</Files>
<Files "config.php">
    Require all denied
</Files>
<Files "tasks_seed.csv">
    Require all denied
</Files>

# 3. Default Charset UTF-8
AddDefaultCharset UTF-8

# 4. Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Gzip Compression for Fast Loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json font/woff2
</IfModule>

# 6. Browser Caching for Static Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
